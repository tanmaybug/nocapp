# Frontend Environment Variables
VITE_API_BASE_URL="http://localhost:8000/v1/"

# Backend Environment Variables - Docker Compose Development
POSTGRES_HOST="postgres"
POSTGRES_PORT=5432
POSTGRES_USER="nocuser"
POSTGRES_PASSWORD="nocpassword"
POSTGRES_DATABASE="nocdb"

# PgAdmin Configuration
PGADMIN_EMAIL="admin@example.com"
PGADMIN_PASSWORD="admin"

# Application Configuration
SECRET_KEY="dev-secret-key-change-in-production"
JWT_SECRET="dev-jwt-secret-change-in-production"

# Set Environment development or production
ENV=development

# Set Frontend URL
FRONTEND_URL="http://localhost:5173"

# Set DEV Backend URL
DEV_URL_1="http://127.0.0.1:8000"
DEV_URL_2="http://localhost:8000"

# Set Redis Host and Port
REDIS_HOST="redis_server"
REDIS_PORT=6379